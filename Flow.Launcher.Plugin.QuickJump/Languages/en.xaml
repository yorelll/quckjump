  <system:String x:Key="quickjump_editor_choose_file_title">Choose a file to jump to</system:String>
  <system:String x:Key="quickjump_editor_choose_folder_title">Choose a folder to jump to</system:String>
  <system:String x:Key="quickjump_editor_all_files">All files|*.*</system:String>
  <system:String x:Key="quickjump_detected_file">File</system:String>
  <system:String x:Key="quickjump_detected_folder">Folder</system:String>
  <system:String x:Key="quickjump_detected_invalid">No valid file or folder found</system:String>
  <system:String x:Key="quickjump_save_failed">Unable to save custom entry.</system:String>

  <system:String x:Key="quickjump_error_alias_required">Alias is required.</system:String>
  <system:String x:Key="quickjump_error_alias_length">Alias must be {0} characters or fewer.</system:String>
  <system:String x:Key="quickjump_error_alias_invalid">Alias may contain only letters, numbers, hyphens, and underscores; spaces and special characters are not allowed.</system:String>
  <system:String x:Key="quickjump_error_path_required">Path is required.</system:String>
  <system:String x:Key="quickjump_error_path_invalid">Path is not a valid Windows path.</system:String>
  <system:String x:Key="quickjump_error_path_missing">Path does not exist or cannot be accessed. Choose an existing file or folder.</system:String>
  <system:String x:Key="quickjump_error_path_type_changed">The path type changed. Save again to detect its type automatically.</system:String>
  <system:String x:Key="quickjump_error_alias_exists">An entry with alias “{0}” already exists.</system:String>
  <system:String x:Key="quickjump_error_entry_missing">Custom entry “{0}” no longer exists.</system:String>
  <system:String x:Key="quickjump_error_detect_path">Unable to detect the path type.</system:String>
  <system:String x:Key="quickjump_alias_fallback">entry</system:String>
</ResourceDictionary>
