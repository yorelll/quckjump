<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
  <system:String x:Key="quickjump_plugin_name">QuickJump</system:String>
  <system:String x:Key="quickjump_plugin_description">Quickly jump to files and folders in open or save dialogs.</system:String>

  <system:String x:Key="quickjump_result_custom_file">Custom file</system:String>
  <system:String x:Key="quickjump_result_custom_folder">Custom folder</system:String>
  <system:String x:Key="quickjump_result_literal_path">Entered path</system:String>
  <system:String x:Key="quickjump_result_open_folder">Open folder</system:String>
  <system:String x:Key="quickjump_context_jump">Jump</system:String>
  <system:String x:Key="quickjump_context_show_path">Show path</system:String>
  <system:String x:Key="quickjump_context_copy_path">Copy path</system:String>
  <system:String x:Key="quickjump_context_add_custom">Add to custom entries</system:String>
  <system:String x:Key="quickjump_context_add_custom_subtitle">Create a persistent file or folder shortcut</system:String>
  <system:String x:Key="quickjump_add_existing_only">Only an existing file or folder can be added to custom entries.</system:String>
  <system:String x:Key="quickjump_add_success">Added to custom entries.</system:String>
  <system:String x:Key="quickjump_jump_elevated_target">The target application is running as administrator, so QuickJump cannot send it keyboard input. Run Flow Launcher with the same privileges, or start that application without administrator rights.</system:String>
  <system:String x:Key="quickjump_jump_folder_picker_with_file">The active dialog selects folders, but the selected custom entry is a file. Choose a folder entry for this dialog.</system:String>
  <system:String x:Key="quickjump_jump_file_dialog_unavailable">The file dialog structure changed before QuickJump could complete the jump. The action was cancelled.</system:String>
  <system:String x:Key="quickjump_jump_filename_not_found">QuickJump navigated to the file's folder but could not find the dialog's filename field. The file name was not filled in.</system:String>
  <system:String x:Key="quickjump_jump_parent_missing">The selected file no longer has a valid parent folder.</system:String>
  <system:String x:Key="quickjump_jump_address_bar_failed">QuickJump could not focus the file dialog's address bar. Try switching Alt+D / Ctrl+L in the settings, or navigate to the target manually.</system:String>
  <system:String x:Key="quickjump_jump_legacy_edit_missing">The legacy file dialog did not expose a filename field, so the jump was cancelled.</system:String>
  <system:String x:Key="quickjump_jump_dialog_not_found">No available native file dialog was found. Open an Open, Save, or folder-selection dialog, then try again.</system:String>
  <system:String x:Key="quickjump_dialog_title">QuickJump</system:String>
  <system:String x:Key="quickjump_dialog_ok">OK</system:String>

  <system:String x:Key="quickjump_settings_title">QuickJump settings</system:String>
  <system:String x:Key="quickjump_settings_custom_entries">Custom entries</system:String>
  <system:String x:Key="quickjump_settings_address_shortcut">Address-bar focus shortcut</system:String>
  <system:String x:Key="quickjump_settings_alt_d">Alt+D (default)</system:String>
  <system:String x:Key="quickjump_settings_ctrl_l">Ctrl+L (fallback)</system:String>
  <system:String x:Key="quickjump_settings_address_help">QuickJump sends the selected shortcut to the Windows native file dialog to focus its address bar, then inserts the path. Alt+D is the default; use Ctrl+L if an app or dialog ignores Alt+D.</system:String>
  <system:String x:Key="quickjump_column_alias">Alias</system:String>
  <system:String x:Key="quickjump_column_path">Path</system:String>
  <system:String x:Key="quickjump_column_type">Type</system:String>
  <system:String x:Key="quickjump_column_enabled">Enabled</system:String>
  <system:String x:Key="quickjump_button_add">Add</system:String>
  <system:String x:Key="quickjump_button_edit">Edit</system:String>
  <system:String x:Key="quickjump_button_delete">Delete</system:String>
  <system:String x:Key="quickjump_select_edit">Select a custom entry to edit.</system:String>
  <system:String x:Key="quickjump_select_delete">Select a custom entry to delete.</system:String>
  <system:String x:Key="quickjump_entry_missing">The selected custom entry no longer exists.</system:String>
  <system:String x:Key="quickjump_update_enabled_failed">Unable to update entry state.</system:String>
  <system:String x:Key="quickjump_delete_confirm">Delete custom entry “{0}”? The original file or folder will not be deleted.</system:String>

  <system:String x:Key="quickjump_editor_add_title">Add custom entry</system:String>
  <system:String x:Key="quickjump_editor_edit_title">Edit custom entry</system:String>
  <system:String x:Key="quickjump_editor_alias">Alias</system:String>
  <system:String x:Key="quickjump_editor_path">Path</system:String>
  <system:String x:Key="quickjump_editor_detected_type">Detected type</system:String>
  <system:String x:Key="quickjump_editor_enabled">Enabled</system:String>
