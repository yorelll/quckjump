<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
  <system:String x:Key="quickjump_plugin_name">QuickJump</system:String>
  <system:String x:Key="quickjump_plugin_description">快速跳转到打开或保存对话框中的文件和文件夹。</system:String>

  <system:String x:Key="quickjump_result_custom_file">自定义文件</system:String>
  <system:String x:Key="quickjump_result_custom_folder">自定义文件夹</system:String>
  <system:String x:Key="quickjump_result_literal_path">输入路径</system:String>
  <system:String x:Key="quickjump_result_open_folder">已打开的文件夹</system:String>
  <system:String x:Key="quickjump_context_jump">跳转</system:String>
  <system:String x:Key="quickjump_context_show_path">显示路径</system:String>
  <system:String x:Key="quickjump_context_copy_path">复制路径</system:String>
  <system:String x:Key="quickjump_context_add_custom">添加到自定义跳转</system:String>
  <system:String x:Key="quickjump_context_add_custom_subtitle">创建一个持久化的文件或文件夹快捷方式</system:String>
  <system:String x:Key="quickjump_add_existing_only">只有现有文件或文件夹可以添加到自定义跳转。</system:String>
  <system:String x:Key="quickjump_add_success">已添加到自定义跳转。</system:String>
  <system:String x:Key="quickjump_jump_elevated_target">目标程序以管理员权限运行，QuickJump 无法向其发送键盘输入。请以相同权限运行 Flow Launcher，或不以管理员身份启动该程序。</system:String>
  <system:String x:Key="quickjump_jump_folder_picker_with_file">当前对话框用于选择文件夹，但所选自定义条目是文件。请为这个对话框选择文件夹条目。</system:String>
  <system:String x:Key="quickjump_jump_file_dialog_unavailable">文件对话框结构在跳转完成前发生了变化，操作已取消。</system:String>
  <system:String x:Key="quickjump_jump_filename_not_found">QuickJump 已导航到文件所在文件夹，但未找到对话框的文件名输入框，未填入文件名。</system:String>
  <system:String x:Key="quickjump_jump_parent_missing">所选文件已不存在有效的父文件夹。</system:String>
  <system:String x:Key="quickjump_jump_address_bar_failed">无法让文件对话框的地址栏获得焦点。请尝试在设置中切换 Alt+D / Ctrl+L，或手动导航到目标位置。</system:String>
  <system:String x:Key="quickjump_jump_legacy_edit_missing">旧版文件对话框中未找到文件名输入框，操作已取消。</system:String>
  <system:String x:Key="quickjump_jump_dialog_not_found">未找到可用的原生文件对话框。请先打开“打开”“保存”或“选择文件夹”对话框，然后重试。</system:String>
  <system:String x:Key="quickjump_dialog_title">QuickJump</system:String>
  <system:String x:Key="quickjump_dialog_ok">确定</system:String>

  <system:String x:Key="quickjump_settings_title">QuickJump 设置</system:String>
  <system:String x:Key="quickjump_settings_custom_entries">自定义跳转</system:String>
  <system:String x:Key="quickjump_settings_address_shortcut">地址栏聚焦快捷键</system:String>
  <system:String x:Key="quickjump_settings_alt_d">Alt+D（默认）</system:String>
  <system:String x:Key="quickjump_settings_ctrl_l">Ctrl+L（备用）</system:String>
  <system:String x:Key="quickjump_settings_address_help">QuickJump 会先向 Windows 原生文件对话框发送所选快捷键以聚焦地址栏，再插入路径。默认使用 Alt+D；如果应用或对话框忽略 Alt+D，请改用 Ctrl+L。</system:String>
  <system:String x:Key="quickjump_column_alias">别名</system:String>
  <system:String x:Key="quickjump_column_path">路径</system:String>
  <system:String x:Key="quickjump_column_type">类型</system:String>
  <system:String x:Key="quickjump_column_enabled">启用</system:String>
  <system:String x:Key="quickjump_button_add">新增</system:String>
  <system:String x:Key="quickjump_button_edit">编辑</system:String>
  <system:String x:Key="quickjump_button_delete">删除</system:String>
  <system:String x:Key="quickjump_select_edit">请先选择要编辑的自定义跳转。</system:String>
  <system:String x:Key="quickjump_select_delete">请先选择要删除的自定义跳转。</system:String>
  <system:String x:Key="quickjump_entry_missing">所选自定义跳转已不存在。</system:String>
  <system:String x:Key="quickjump_update_enabled_failed">无法更新条目状态。</system:String>
  <system:String x:Key="quickjump_delete_confirm">确定删除自定义跳转“{0}”吗？原始文件或文件夹不会被删除。</system:String>

  <system:String x:Key="quickjump_editor_add_title">新增自定义跳转</system:String>
  <system:String x:Key="quickjump_editor_edit_title">编辑自定义跳转</system:String>
  <system:String x:Key="quickjump_editor_alias">别名</system:String>
  <system:String x:Key="quickjump_editor_path">路径</system:String>
  <system:String x:Key="quickjump_editor_detected_type">自动识别类型</system:String>
  <system:String x:Key="quickjump_editor_enabled">启用</system:String>
  <system:String x:Key="quickjump_editor_choose_file">选择文件…</system:String>
  <system:String x:Key="quickjump_editor_choose_folder">选择文件夹…</system:String>
  <system:String x:Key="quickjump_editor_save">保存</system:String>
  <system:String x:Key="quickjump_editor_cancel">取消</system:String>
  <system:String x:Key="quickjump_editor_alias_tooltip">只能包含字母、数字、连字符和下划线；按 Enter 保存。</system:String>
  <system:String x:Key="quickjump_editor_choose_file_title">选择要快速跳转的文件</system:String>
  <system:String x:Key="quickjump_editor_choose_folder_title">选择要快速跳转的文件夹</system:String>
  <system:String x:Key="quickjump_editor_all_files">所有文件|*.*</system:String>
  <system:String x:Key="quickjump_detected_file">文件</system:String>
  <system:String x:Key="quickjump_detected_folder">文件夹</system:String>
  <system:String x:Key="quickjump_detected_invalid">未找到有效的文件或文件夹</system:String>
  <system:String x:Key="quickjump_save_failed">无法保存自定义跳转。</system:String>

  <system:String x:Key="quickjump_error_alias_required">别名不能为空。</system:String>
  <system:String x:Key="quickjump_error_alias_length">别名长度不能超过 {0} 个字符。</system:String>
  <system:String x:Key="quickjump_error_alias_invalid">别名只能包含字母、数字、连字符和下划线，不能包含空格或特殊字符。</system:String>
  <system:String x:Key="quickjump_error_path_required">路径不能为空。</system:String>
  <system:String x:Key="quickjump_error_path_invalid">路径不是有效的 Windows 路径。</system:String>
  <system:String x:Key="quickjump_error_path_missing">路径不存在或无法访问。请选择一个现有文件或文件夹。</system:String>
  <system:String x:Key="quickjump_error_path_type_changed">路径类型已变化，请重新保存以自动识别类型。</system:String>
  <system:String x:Key="quickjump_error_alias_exists">别名“{0}”已存在。</system:String>
  <system:String x:Key="quickjump_error_entry_missing">自定义跳转“{0}”已不存在。</system:String>
  <system:String x:Key="quickjump_error_detect_path">无法识别路径类型。</system:String>
  <system:String x:Key="quickjump_alias_fallback">条目</system:String>
</ResourceDictionary>
